{
  "expo": {
    "name": "Acewise",
    "slug": "acewise",
    "scheme": "acewise",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ofeklevi.acewise"
    },
    "android": { "package": "com.ofeklevi.acewise" },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Acewise",
      "favicon": "./assets/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
